      "contentMode": "summary",
      "sections": [
        {
          "title": "Class tuning",
          "date": null,
          "lines": [
            {
              "text": "Feral Druid and Fire Mage: damage rises 5% outside PvP.",
              "path": []
            },
            {
              "text": "Restoration Druid: Verdancy gains 60% healing and Regrowth gains 10%, outside PvP; Improved Swiftmend grants 40% instead of 30%.",
              "path": []
            },
            {
              "text": "Marksmanship: Trick Shots ricochet bonus becomes 85%; Explosive Shot and Volley gain 10% damage.",
              "path": []
            },
            {
              "text": "Subtlety: ability damage falls 8%; Trickster’s Fazed bonus becomes 5%.",
              "path": []
            },
            {
              "text": "Affliction: Unstable Affliction gains 20% damage outside PvP. Destruction: Rain of Fire gains 20%.",
              "path": []
            }
          ]
        }
      ]
